include(CMakeFindDependencyMacro)
include(CMakePackageConfigHelpers)

# --- 可重定位前缀推导 ---
# 本文件安装在 <prefix>/lib/cmake/TBoxFramework/，向上三级即安装前缀。
# 不使用 configure_file 固化 @CMAKE_INSTALL_PREFIX@，以便同一套产物在
# 不同前缀（本地 ${HOME}/.local、生产 /opt/tbox、交叉编译 sysroot）下都能被消费。
get_filename_component(_tbox_fw_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)

# --- 对外变量 ---
# yaml-cpp 的静态库已被 force_load/whole-archive 进 libtbox-framework，
# 头文件随 framework 一起安装到 include/tbox-framework/yaml-cpp/，
# 因此消费方无需自备 yaml-cpp 包（不要在此 find_dependency(yaml-cpp)）。
set(TBoxFramework_LIBRARIES TBoxFramework::tbox-framework)
set(TBoxFramework_INCLUDE_DIRS "${_tbox_fw_prefix}/include/tbox-framework")

# 兼容早期消费方使用的单数形式
set(TBoxFramework_INCLUDE_DIR "${TBoxFramework_INCLUDE_DIRS}")

unset(_tbox_fw_prefix)

# 包含目标文件
include("${CMAKE_CURRENT_LIST_DIR}/TBoxFrameworkTargets.cmake")

set(TBoxFramework_FOUND TRUE)
